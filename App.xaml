<Application x:Class="colizeumUpdateManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- Material Design 3 defaults (v5+) -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <!-- Choose ONE base theme -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Dark.xaml" />

                <!-- Bundled palette -->
                <materialDesign:BundledTheme BaseTheme="Dark"
                                             PrimaryColor="Grey"
                                             SecondaryColor="Lime" />

            </ResourceDictionary.MergedDictionaries>

            <!-- Optional: closer to AMOLED -->
            <SolidColorBrush x:Key="MaterialDesignPaper" Color="#FF0F0F0F"/>
            <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="#FF151515"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
