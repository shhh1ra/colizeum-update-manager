<UserControl x:Class="colizeumUpdateManager.Views.TimerSlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>

        <!-- акцент -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FCEE09"/>

        <!-- карточка слота -->
        <Style x:Key="SlotCardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="#5E5E5E"/>
        </Style>

        <!-- скруглённый инпут -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Height" Value="52"/>

            <!-- ВАЖНО: вертикальный центр -->
            <Setter Property="Padding" Value="14,14"/>

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>

            <!-- горизонтальный центр -->
            <Setter Property="TextAlignment" Value="Center"/>

            <!-- курсор и выделение -->
            <Setter Property="CaretBrush" Value="#FCEE09"/>
            <Setter Property="SelectionBrush" Value="#FCEE09"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>

            <Setter Property="Cursor" Value="IBeam"/>
        </Style>

        <!-- кнопки справа -->
        <Style x:Key="SlotIconButton" TargetType="Button">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- плейсхолдер базовый -->
        <Style x:Key="PlaceholderBase" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FFFFFFF"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

    </UserControl.Resources>

    <Border>
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource SlotCardBorder}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Background" Value="#707070"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- NOTE -->
            <Border Grid.Column="0"
                    CornerRadius="10"
                    Background="Black"
                    Margin="0,0,16,0">
                <Grid>
                    <TextBox Style="{StaticResource RoundedTextBox}"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Название">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Note}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- GOAL TEXT -->
            <Border Grid.Column="1"
                    CornerRadius="10"
                    Background="Black"
                    Margin="0,0,16,0">
                <Grid>
                    <TextBox Style="{StaticResource RoundedTextBox}"
                             Text="{Binding GoalText, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Сколько работать">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GoalText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding GoalText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- ELAPSED -->
            <TextBlock Grid.Column="2"
                       Text="{Binding ElapsedText}"
                       FontSize="44"
                       Foreground="#1A1A1A"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>

            <!-- Buttons -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SlotIconButton}"
                        Command="{Binding PlayPauseCommand}">
                    <materialDesign:PackIcon Width="22" Height="22" Foreground="White">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="Play"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Kind" Value="Pause"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Button>

                <Button Style="{StaticResource SlotIconButton}"
                        Margin="0"
                        Command="{Binding ResetCommand}">
                    <materialDesign:PackIcon Kind="Replay" Width="22" Height="22" Foreground="White"/>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>