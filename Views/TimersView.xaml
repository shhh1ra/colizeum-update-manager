<UserControl x:Class="colizeumUpdateManager.Views.TimersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:colizeumUpdateManager.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <views:TimerSlotView DataContext="{Binding Slot1}"/>
            <views:TimerSlotView DataContext="{Binding Slot2}"/>
            <views:TimerSlotView DataContext="{Binding Slot3}"/>
            <views:TimerSlotView DataContext="{Binding Slot4}"/>
            <views:TimerSlotView DataContext="{Binding Slot5}"/>
            <views:TimerSlotView DataContext="{Binding Slot6}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
