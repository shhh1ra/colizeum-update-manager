<Window x:Class="colizeumUpdateManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="colizeumUpdateManager"
        Height="846"
        Width="480"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize">

    <Grid>

        <!-- ===== Custom TitleBar ===== -->
        <Border Height="42"
                Background="#FF111111"
                BorderBrush="#FF2A2A2A"
                BorderThickness="0,0,0,1"
                VerticalAlignment="Top"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock Text="colizeumUpdateManager"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <!-- Window buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">

                    <Button Width="46" Height="42"
                            ToolTip="Свернуть"
                            Click="Minimize_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            Content="—"/>

                    <Button Width="46" Height="42"
                            ToolTip="Развернуть"
                            Click="Maximize_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            Content="□"/>

                    <Button Width="46" Height="42"
                            ToolTip="Закрыть"
                            Click="Close_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            Content="✕"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== App content ===== -->
        <Grid Margin="16,58,16,16">
            <materialDesign:Card Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ComboBox Grid.Row="0"
                              ItemsSource="{Binding Pcs}"
                              SelectedItem="{Binding SelectedPc}"
                              DisplayMemberPath="Name"
                              Margin="0,0,0,12"
                              Height="34" />

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <DatePicker Grid.Column="0"
                                    SelectedDate="{Binding SelectedDate}"
                                    Height="34" />

                        <Button Grid.Column="1"
                                Content="Сохранить"
                                Command="{Binding SaveCommand}"
                                Margin="12,0,0,0"
                                Height="34"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Games}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              RowEditEnding="DataGrid_RowEditEnding">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Игра"
                                                Binding="{Binding GameName}"
                                                IsReadOnly="True"
                                                Width="*" />

                            <DataGridTemplateColumn Header="Вчера" IsReadOnly="True" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsUpdatedYesterday, Mode=OneWay}"
                                                  IsHitTestVisible="False"
                                                  Focusable="False"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridCheckBoxColumn Header="Обновлено"
                                                    Binding="{Binding IsUpdated, Mode=TwoWay}"
                                                    Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
